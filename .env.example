# Copy to .env and fill in. No keys are used anywhere: sign in with `az login`
# (or run under a managed identity) and grant the roles listed in docs/prerequisites.md.

# Azure AI Search
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=contoso-kb
SEARCH_API_VERSION=2025-09-01
SEMANTIC_CONFIG=contoso-semantic

# Azure OpenAI (Foundry / AI Services account)
AOAI_ENDPOINT=https://<ai-services-account>.openai.azure.com
AOAI_API_VERSION=2024-10-21
EMBEDDING_DEPLOYMENT=text-embedding-3-large
# 3072 is the native size of text-embedding-3-large. 1024 or 1536 work too (Matryoshka)
# and cut vector storage; change it BEFORE creating the index.
EMBEDDING_DIMENSIONS=3072
CHAT_DEPLOYMENT=gpt-4.1-mini

# Storage (system of record for documents)
STORAGE_ACCOUNT=<storage-account-name>
STORAGE_CONTAINER=contoso-docs

# Cosmos DB (system of record for the catalog)
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=ContosoCatalog
COSMOS_PARTS_CONTAINER=parts
COSMOS_XREF_CONTAINER=crossReference
